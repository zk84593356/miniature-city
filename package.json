{
  "name": "miniature-city-private-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs --side rebuild --root site --origin-host cityinminiatures.top --stub-ext-hosts static.cloudflareinsights.com --port 4173",
    "site:build": "node scripts/build-site.mjs --config scripts/shell-config.mjs",
    "verify": "npm run verify:site && npm run verify:source && npm run verify:tools",
    "verify:site": "node scripts/build-site.mjs --config scripts/shell-config.mjs --check && node scripts/verify-shell.mjs --config scripts/shell-config.mjs",
    "verify:source": "node scripts/verify-reassembly.mjs --dir src/readable --against site/assets",
    "verify:tools": "node scripts/verify-zerodep.mjs",
    "public:build": "node scripts/build-public.mjs",
    "public:verify": "npm run public:build && node scripts/verify-public.mjs && node scripts/verify-ride.mjs",
    "public:serve": "node scripts/serve.mjs --side rebuild --root public-site --origin-host cityinminiatures.top --stub-ext-hosts static.cloudflareinsights.com --port 4174",
    "verify:ride": "node scripts/verify-ride.mjs",
    "atlas:build": "npm run public:build && node scripts/build-atlas.mjs",
    "atlas:serve": "node scripts/serve.mjs --side rebuild --root atlas-site --origin-host cityinminiatures.top --stub-ext-hosts static.cloudflareinsights.com --port 4175",
    "atlas:verify": "node scripts/verify-atlas.mjs && node tools/wuhan/verify-surfaces.mjs",
    "wuhan:browser": "node tools/wuhan/browser-check-phase2.mjs && node tools/wuhan/browser-check-phase3.mjs",
    "wuhan:landmarks:verify": "node tools/wuhan/verify-landmark-models.mjs && node tools/wuhan/verify-pack-bytes.mjs",
    "wuhan:traffic:verify": "node tools/wuhan/verify-dynamics.mjs && node tools/wuhan/verify-traffic-collisions.mjs",
    "wuhan:vessels:verify": "node tools/wuhan/verify-vessels.mjs",
    "wuhan:dynamics:browser": "node tools/wuhan/browser-check-phase4.mjs",
    "wuhan:ride:verify": "node tools/wuhan/verify-ride.mjs",
    "wuhan:ride:browser": "node tools/wuhan/browser-check-phase5.mjs",
    "wuhan:road:verify": "python tools/wuhan/verify-road-continuity.py",
    "wuhan:vegetation:verify": "python tools/wuhan/verify-vegetation.py",
    "wuhan:highspeed:verify": "node tools/wuhan/verify-phase6-ride.mjs && node tools/wuhan/verify-main-routes.mjs && node tools/wuhan/verify-bridge-transitions.mjs",
    "wuhan:final:browser": "node tools/wuhan/browser-check-phase6.mjs",
    "wuhan:checkout:verify": "node tools/wuhan/verify-git-checkout.mjs",
    "wuhan:screenshots:verify": "node tools/wuhan/verify-screenshot-regressions.mjs && node tools/wuhan/verify-phase61-approach.mjs",
    "wuhan:bridge-runtime:verify": "node tools/wuhan/verify-phase61-bridge-runtime.mjs && node tools/wuhan/verify-phase61-residency.mjs",
    "wuhan:airwall:verify": "node tools/wuhan/verify-phase61-airwall.mjs",
    "wuhan:collision:verify": "node tools/wuhan/verify-phase61-collision.mjs && node tools/wuhan/verify-phase61-ground-join.mjs",
    "wuhan:phase61:browser": "node tools/wuhan/browser-check-phase61.mjs",
    "wuhan:phase61:browser-report": "node tools/wuhan/verify-phase61-browser-report.mjs",
    "wuhan:diagnostics:browser": "node tools/wuhan/browser-check-phase61-diagnostics.mjs",
    "wuhan:explore:browser": "node tools/wuhan/browser-explore-phase61.mjs"
  },
  "dependencies": {
    "three": "0.185.0"
  }
}
