[{"id":"yellow-crane","nameZh":"黄鹤楼","nameEn":"Yellow Crane Tower","kind":"landmark","district":"武昌 · 蛇山","description":"层叠飞檐立于蛇山之上，与长江大桥和龟山隔江相望。暖黄色屋顶与红柱，构成武汉最熟悉的城市轮廓。","position":[114.29704578961626,30.547078026754228],"anchor":[-21.97860403920462,1.2065351243154725,14.368598518392188],"priority":100,"source":"https://zjt.hubei.gov.cn/bmdt/ztzl/hbcjda/gzdt_7471/201910/t20191028_79891.shtml","cameraPreset":"place-yellow-crane","maxLabelDistance":55},{"id":"customs","nameZh":"江汉关","nameEn":"Hankow Customs House","kind":"landmark","district":"汉口 · 沿江大道","description":"钟楼面向长江，低层历史建筑与现代汉口相互映衬。这里连接江汉路与江岸，也是理解武汉近代港口生活的一处起点。","position":[114.29200340497823,30.578581048008708],"anchor":[-26.806675818630044,0.8365876879338678,-20.661211241515737],"priority":70,"source":"https://www.dxh.gov.cn/YXLKG_16692/wszl/202508/P020250910558092916823.pdf","cameraPreset":"place-customs","maxLabelDistance":55},{"id":"greenland","nameZh":"武汉绿地中心","nameEn":"Wuhan Greenland Center","kind":"landmark","district":"武昌 · 滨江","description":"现状塔楼以收分的三向体量面向长江，成为武昌滨江天际线的突出节点。本模型采用已建成高度，而非早期超六百米方案。","position":[114.31732162896844,30.585805758612306],"anchor":[-2.564534148127068,5.067545285445012,-28.69473399382703],"priority":70,"source":"https://www.skyscrapercenter.com/building/wuhan-greenland-center/33983","cameraPreset":"place-greenland","maxLabelDistance":130},{"id":"wuhan-center","nameZh":"武汉中心","nameEn":"Wuhan Center Tower","kind":"landmark","district":"汉口 · 王家墩 CBD","description":"塔身以弧面、转折与收束的顶部形成向上的动势。它与周边城市组团共同勾勒汉口中央商务区的现代轮廓。","position":[114.23967033254492,30.596638495491643],"anchor":[-76.91547319997143,4.581709961449456,-40.74020445829193],"priority":70,"source":"https://www.skyscraper.org/supertall/building/wuhan-center-tower/","cameraPreset":"place-wuhan-center","maxLabelDistance":130},{"id":"qingchuan-pavilion","nameZh":"晴川阁","nameEn":"Qingchuan Pavilion","kind":"landmark","district":"汉阳 · 禹功矶","description":"重檐楼阁立在龟山东麓的临江台地，与对岸黄鹤楼相望。近处的汉江入江口，使这里成为观察两江空间关系的好位置。","position":[114.27988755188703,30.558657656835248],"anchor":[-38.407577493628196,0.6029547659381649,1.4926195590547122],"priority":70,"source":"https://www.wuhan.gov.cn/sy/whyw/202603/t20260310_2737325.shtml","cameraPreset":"place-qingchuan-pavilion","maxLabelDistance":55},{"id":"guishan-tower","nameZh":"龟山电视塔","nameEn":"Guishan TV Tower","kind":"landmark","district":"汉阳 · 龟山","description":"细长塔身、环形观景结构与天线从真实龟山地形中升起。它与黄鹤楼分立长江两岸，标示出龟蛇两山的城市关系。","position":[114.27508207758915,30.558019907297076],"anchor":[-43.008808163211505,3.2099034006316045,2.2017656697111985],"priority":70,"source":"https://www.wuhan.gov.cn/sy/whyw/202601/t20260131_2722823.shtml","cameraPreset":"place-guishan-tower","maxLabelDistance":130},{"id":"wuhan-university","nameZh":"武汉大学","nameEn":"Wuhan University · Old Library","kind":"landmark","district":"武昌 · 狮子山 / 珞珈山","description":"老图书馆位于校园狮子山，周围历史建筑顺坡展开。青绿色屋顶、重檐塔楼与台阶共同呈现山地校园的层次，远处便是东湖。","position":[114.35816129173189,30.54252075281859],"anchor":[36.5393497131394,1.087933996817055,19.436062927585],"priority":70,"source":"https://news.whu.edu.cn/info/1017/46877.htm","cameraPreset":"place-wuhan-university","maxLabelDistance":55},{"id":"hubei-museum","nameZh":"湖北省博物馆","nameEn":"Hubei Provincial Museum","kind":"landmark","district":"武昌 · 东湖西岸","description":"南馆与北馆、东西两翼共同构成今日馆区。层叠的大屋顶呼应荆楚文化，湖岸与公共建筑之间保留着舒展的空间。","position":[114.36037244224174,30.563021696466272],"anchor":[38.656521278382804,0.7354241375843624,-3.3599778100853226],"priority":70,"source":"https://m-www.hbww.org.cn/p/9256.html","cameraPreset":"place-hubei-museum","maxLabelDistance":55},{"id":"wuhan-station","nameZh":"武汉站","nameEn":"Wuhan Railway Station","kind":"landmark","district":"洪山 · 杨春湖","description":"舒展的站房屋盖沿铁路站场展开，起伏的屋顶形成大型交通建筑的独特轮廓。这里是武汉面向高铁网络的重要门户。","position":[114.41881252112566,30.6096041796943],"anchor":[94.6127633942153,0.9324643971788475,-55.15740741026731],"priority":70,"source":"https://www.arep.fr/app/uploads/2025/12/AREP_BOOK-INTERNATIONAL_VA_maj-2025_EXE_Web_Pap.pdf","cameraPreset":"place-wuhan-station","maxLabelDistance":55},{"id":"calla","nameZh":"光谷马蹄莲","nameEn":"Wuhan Energy Flower","kind":"landmark","district":"光谷 · 未来科技城","description":"花瓣状主塔与叶片形裙房构成仿生建筑群。向上展开的曲面屋顶，使新能源研究院在光谷的城市景观中格外醒目。","position":[114.53390157574798,30.492910699944286],"anchor":[204.81027045305007,1.710399550917166,74.60000102506693],"priority":70,"source":"https://www.wehdz.gov.cn/2022/ggxw_68627/ggxw_68629/202111/t20211117_1838809.shtml","cameraPreset":"place-calla","maxLabelDistance":130},{"id":"qintai-theater","nameZh":"琴台大剧院","nameEn":"Qintai Grand Theatre","kind":"landmark","district":"汉阳 · 月湖","description":"展开的屋面与成组的竖向构件，让文化建筑在月湖边形成鲜明轮廓。它与周围文化场馆共同回应汉阳的知音传统。","position":[114.25401840495013,30.563375732763348],"anchor":[-63.17722662785246,0.808208462962714,-3.7536487546772763],"priority":70,"source":"https://www.600496.com/Business/detail/id/579/t/1","cameraPreset":"place-qintai-theater","maxLabelDistance":55},{"id":"xingyin","nameZh":"东湖行吟阁","nameEn":"Xingyin Pavilion","kind":"landmark","district":"东湖 · 听涛","description":"青瓦楼阁靠近听涛湖岸，体量不大，却把湖水、岸线与文化景观连接起来。可从这里继续浏览省博、东湖绿道与磨山。","position":[114.37112332370172,30.567327955895628],"anchor":[48.95046573263829,0.5037334982855273,-8.148326437622941],"priority":70,"source":"https://www.wuhan.gov.cn/zjwh/whly/202303/t20230318_2171936.shtml","cameraPreset":"place-xingyin","maxLabelDistance":55},{"id":"bridge-yangtze-first","nameZh":"武汉长江大桥","nameEn":"Wuhan Yangtze River Bridge","kind":"bridge","district":"武汉 · 两江","description":"钢桁架横跨长江，上层公路与下层铁路构成双层通道。两岸山体与桥头建筑共同形成武汉经典的江城画面。","position":[114.28308087496647,30.551931078394365],"anchor":[-35.349977935250344,0.7170144,8.97224385336595],"priority":45,"source":"https://www.wuhan.gov.cn/ztzl/25zt/qiao/whzjdq/index.shtml","cameraPreset":"place-bridge-yangtze-first","maxLabelDistance":160},{"id":"bridge-yingwuzhou","nameZh":"鹦鹉洲长江大桥","nameEn":"Yingwuzhou Bridge","kind":"bridge","district":"武汉 · 两江","description":"主缆在塔间形成舒展的曲线，吊索把桥面悬起。跨江通道连接两岸城区，也为江面带来鲜明的桥梁轮廓。","position":[114.27680330040259,30.533980599794166],"anchor":[-41.360741248798384,0.7472951,28.932292935159964],"priority":45,"source":"https://www.wuhan.gov.cn/sy/whyw/202407/t20240717_2429341.shtml","cameraPreset":"place-bridge-yingwuzhou","maxLabelDistance":160},{"id":"bridge-yangsigang","nameZh":"杨泗港长江大桥","nameEn":"Yangsigang Bridge","kind":"bridge","district":"武汉 · 两江","description":"主缆在塔间形成舒展的曲线，吊索把桥面悬起。跨江通道连接两岸城区，也为江面带来鲜明的桥梁轮廓。","position":[114.25738819997105,30.509513399970974],"anchor":[-59.95065558838692,0.7777643,56.13861540945535],"priority":45,"source":"https://www.wuhan.gov.cn/ztzl/25zt/qiao/ysgzjdq/index.shtml","cameraPreset":"place-bridge-yangsigang","maxLabelDistance":160},{"id":"bridge-erqi","nameZh":"二七长江大桥","nameEn":"Erqi Bridge","kind":"bridge","district":"武汉 · 两江","description":"扇形斜拉索从桥塔伸向桥面，以轻盈的线条跨越长江。顺着江岸望去，可以观察它与其他桥梁不同的结构。","position":[114.33986014709113,30.62922048239879],"anchor":[19.016045500127152,0.7155659999999999,-76.96977094137195],"priority":45,"source":"https://www.wuhan.gov.cn/sy/whyw/202407/t20240717_2429341.shtml","cameraPreset":"place-bridge-erqi","maxLabelDistance":160},{"id":"bridge-qingchuan","nameZh":"晴川桥","nameEn":"Qingchuan Bridge","kind":"bridge","district":"武汉 · 两江","description":"红色拱肋跨过汉江，靠近两江交汇处。桥面与晴川阁、龟山和汉口江岸一起，构成紧凑而丰富的滨水景观。","position":[114.27904112583992,30.56595089349646],"anchor":[-39.2180285013878,0.5823944,-6.617100798001893],"priority":45,"source":"https://www.wuhan.gov.cn/gwfbpt/sbm/sjtysj_79502/202311/t20231129_2309645.shtml","cameraPreset":"place-bridge-qingchuan","maxLabelDistance":160},{"id":"bridge-yangtze-second","nameZh":"武汉长江二桥","nameEn":"Second Wuhan Yangtze River Bridge","kind":"bridge","district":"武汉 · 两江","description":"扇形斜拉索从桥塔伸向桥面，以轻盈的线条跨越长江。顺着江岸望去，可以观察它与其他桥梁不同的结构。","position":[114.31980348638898,30.60532663513017],"anchor":[-0.18816133391289183,0.6960284999999999,-50.40098830015369],"priority":45,"source":"https://www.wuhan.gov.cn/ztzl/25zt/qiao/whzjeq/index.shtml","cameraPreset":"place-bridge-yangtze-second","maxLabelDistance":160},{"id":"moshan-chutian","nameZh":"磨山 · 楚天台","nameEn":"Moshan · Chutian Terrace","kind":"nature","district":"武汉 · 湖山","description":"沿着磨山山脊观察东湖的湖汊与半岛。楚天台所在区域提供了文化景观与真实山体共同构成的湖区视角。","position":[114.41070929659558,30.55352375],"anchor":[86.85394440589387,1.1554804787983974,7.201271383622651],"priority":35,"source":"https://www.openstreetmap.org/way/236231353","estimated":false,"confidence":"medium","checkedAt":"2026-09-26","cameraPreset":"place-moshan-chutian","maxLabelDistance":130},{"id":"hankou-riverfront","nameZh":"汉口江滩","nameEn":"Hankou Riverfront","kind":"nature","district":"武汉 · 江岸","description":"从滨江步道望向长江，历史街区、高层建筑与跨江桥梁层层展开。这里把城市日常生活与宽阔江面连接在一起。","position":[114.29913,30.588],"anchor":[-19.982977354914922,0.3680712482779418,-31.134622465391715],"priority":35,"source":"https://mapcarta.com/N10799812648","estimated":true,"confidence":"medium","checkedAt":"2026-09-26","cameraPreset":"place-hankou-riverfront","maxLabelDistance":130},{"id":"shahu","nameZh":"沙湖","nameEn":"Shahu Lake","kind":"nature","district":"武汉 · 湖泊","description":"沙湖嵌在武昌城市之中，水面与密集街区相邻。沿湖观察，可以感受到武汉湖泊与现代城市共存的空间尺度。","position":[114.34325331717892,30.575977244451447],"anchor":[22.26499811276581,0.35,-17.765909786896145],"priority":35,"source":"https://www.openstreetmap.org/relation/7160933","estimated":false,"confidence":"medium","checkedAt":"2026-09-26","cameraPreset":"place-shahu","maxLabelDistance":130},{"id":"donghu-greenway","nameZh":"东湖绿道","nameEn":"East Lake Greenway","kind":"nature","district":"武汉 · 湖岸","description":"绿道沿真实湖岸和道路延伸，将校园、林地与湖区景观连接起来。推荐从武大出发，依次浏览听涛、省博和磨山。","position":[114.41142819949589,30.588332410567943],"anchor":[87.54229229171779,0.414683189676633,-31.504246663120153],"priority":35,"source":"https://www.openstreetmap.org/way/700522545","estimated":false,"confidence":"medium","checkedAt":"2026-09-26","cameraPreset":"place-donghu-greenway","maxLabelDistance":130}]
